# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=striker21
DATABASE_URL=postgresql://postgres:password@localhost:5432/striker21

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Provider API Keys
# Replace these with real keys or use a local model adapter
OPENAI_API_KEY=your_openai_key_here
STABILITY_API_KEY=your_stability_key_here
HUGGINGFACE_TOKEN=your_hf_token_here

# Asset Storage
STORAGE_TYPE=local # options: local, s3
STORAGE_PATH=./storage
S3_BUCKET=striker21-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_key
S3_SECRET_KEY=your_s3_secret

# Application Settings
APP_ENV=development
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
